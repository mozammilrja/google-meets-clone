# MeetClone Production Environment Configuration
# Copy this file to .env and fill in production values

# =================================================================
# Core Settings
# =================================================================
NODE_ENV=production
CLIENT_URL=https://meet.yourdomain.com

# =================================================================
# Security
# =================================================================
# IMPORTANT: Generate a strong secret for production!
# openssl rand -base64 64
JWT_SECRET=your-production-jwt-secret-here

# =================================================================
# Database
# =================================================================
MONGODB_URI=mongodb://user:password@mongodb:27017/meetclone?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secure-mongo-password

# =================================================================
# Redis
# =================================================================
REDIS_URL=redis://redis:6379

# Enable Redis-backed signaling for horizontal scaling
ENABLE_REDIS_SIGNALING=true

# =================================================================
# Media Server (Mediasoup)
# =================================================================
# Number of mediasoup workers (default: number of CPU cores)
MEDIASOUP_WORKERS=4

# Public IP of the server (REQUIRED for WebRTC)
PUBLIC_IP=your.server.public.ip

# Port range for RTC traffic (ensure firewall allows UDP)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# =================================================================
# TURN Server
# =================================================================
TURN_SECRET=your-turn-server-shared-secret

# TURN URL format for clients
TURN_URL=turn:your.server.public.ip:3478
TURN_USERNAME=meetclone
TURN_CREDENTIAL=your-turn-server-shared-secret

# =================================================================
# API Endpoints (for frontend build)
# =================================================================
API_URL=https://meet.yourdomain.com/api
SIGNALING_URL=https://meet.yourdomain.com
MEDIA_URL=https://meet.yourdomain.com:7000

# =================================================================
# Recording (optional)
# =================================================================
RECORDING_ENABLED=false
RECORDING_PATH=/var/recordings

# =================================================================
# Logging
# =================================================================
LOG_LEVEL=info
MEDIASOUP_WORKER_LOG_LEVEL=warn
