// Backend API endpoints (NestJS on port 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

// WebSocket URLs
// Signaling WebSocket on backend port 4000
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000
// Media Server - Mediasoup SFU on port 7000 (browser-safe port)
NEXT_PUBLIC_MEDIA_URL=http://localhost:7000

// Feature flags
NEXT_PUBLIC_ENABLE_RECORDING=false
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_SCREEN_SHARE=true

// Analytics (optional)
NEXT_PUBLIC_GA_ID=
