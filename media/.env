# Media Server Configuration
# Port 7000 is used because port 6000 is blocked by browsers (ERR_UNSAFE_PORT)
PORT=7000
NODE_ENV=development

# JWT Secret (must match backend)
JWT_SECRET=change-me

# Mediasoup Configuration
MEDIASOUP_NUM_WORKERS=4
MEDIASOUP_WORKER_LOG_LEVEL=warn
MEDIASOUP_WORKER_LOG_TAGS=info,ice,dtls,rtp,srtp,rtcp

# WebRTC Configuration
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Port ranges for WebRTC
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# CORS
CORS_ORIGINS=http://localhost:3000

# Recording
RECORDING_ENABLED=false
RECORDING_PATH=/tmp/recordings
